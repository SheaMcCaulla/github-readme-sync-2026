          },
          "400": {
            "description": "无效的状态值"
          },
          "default": {
            "description": "非预期错误"
          }
        },
        "security": [
          {
            "petstore_auth": [
              "write:pets",
              "read:pets"
            ]
          }
        ]
      }
    },
